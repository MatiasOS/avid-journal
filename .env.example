# AViD Journal - environment variables (copy to .env and fill in)

# Semantic Scholar Graph API key (https://www.semanticscholar.org/product/api)
# Used by src/novelty/arxiv_search.py to query paper/search at higher rate limits.
SEMANTIC_SCHOLAR_API_KEY=your-ss-api-key-here

# Anthropic API key for Claude (used by src/novelty/llm_judge.py).
ANTHROPIC_API_KEY=
